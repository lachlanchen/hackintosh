+// The Hackintosh KVM can be reached through source keyboards with different
+// layouts. QEMU's extended key event normally sends the physical key position,
+// which makes punctuation wrong when the source layout and macOS layout differ.
+// Translate printable ASCII punctuation to an explicit US virtual-key chord;
+// letters, shortcuts, navigation keys, and input-method events stay untouched.
+const layoutSafeUSChords = new Map([
+    [0x21, ["Digit1", true]],     // !
+    [0x22, ["Quote", true]],      // "
+    [0x23, ["Digit3", true]],     // #
+    [0x24, ["Digit4", true]],     // $
+    [0x25, ["Digit5", true]],     // %
+    [0x26, ["Digit7", true]],     // &
+    [0x27, ["Quote", false]],     // '
+    [0x28, ["Digit9", true]],     // (
+    [0x29, ["Digit0", true]],     // )
+    [0x2a, ["Digit8", true]],     // *
+    [0x2b, ["Equal", true]],      // +
+    [0x2c, ["Comma", false]],     // ,
+    [0x2d, ["Minus", false]],     // -
+    [0x2e, ["Period", false]],    // .
+    [0x2f, ["Slash", false]],     // /
+    [0x3a, ["Semicolon", true]],  // :
+    [0x3b, ["Semicolon", false]], // ;
+    [0x3c, ["Comma", true]],      // <
+    [0x3d, ["Equal", false]],     // =
+    [0x3e, ["Period", true]],     // >
+    [0x3f, ["Slash", true]],      // ?
+    [0x40, ["Digit2", true]],     // @
+    [0x5b, ["BracketLeft", false]],  // [
+    [0x5c, ["Backslash", false]],    // \
+    [0x5d, ["BracketRight", false]], // ]
+    [0x5e, ["Digit6", true]],        // ^
+    [0x5f, ["Minus", true]],         // _
+    [0x60, ["Backquote", false]],    // `
+    [0x7b, ["BracketLeft", true]],   // {
+    [0x7c, ["Backslash", true]],     // |
+    [0x7d, ["BracketRight", true]],  // }
+    [0x7e, ["Backquote", true]],     // ~
+]);
+
+const layoutSafeShiftCodes = new Set(["ShiftLeft", "ShiftRight"]);
+const layoutSafeShortcutModifierCodes = new Set([
+    "ControlLeft", "ControlRight", "AltLeft", "AltRight",
+    "MetaLeft", "MetaRight",
+]);
