+    _sendLayoutSafeExtendedKey(keysym, code, down) {
+        const scancode = XtScancode[code];
+        if (!scancode) {
+            return false;
+        }
+        RFB.messages.QEMUExtendedKeyEvent(this._sock, keysym, down, scancode);
+        return true;
+    }
+
+    _sendLayoutSafePunctuation(keysym, targetCode, targetShift) {
+        const sourceShifts = Array.from(this._layoutSafeSourceShifts);
+
+        // A JIS source may need Shift to produce an unshifted US character
+        // (for example Shift+7 -> apostrophe). Temporarily normalize the guest
+        // modifier state, emit the intended US chord, then restore held keys.
+        for (const sourceCode of sourceShifts) {
+            const sourceKeysym = sourceCode === "ShiftRight" ?
+                KeyTable.XK_Shift_R : KeyTable.XK_Shift_L;
+            this._sendLayoutSafeExtendedKey(sourceKeysym, sourceCode, false);
+        }
+        if (targetShift) {
+            this._sendLayoutSafeExtendedKey(KeyTable.XK_Shift_L, "ShiftLeft", true);
+        }
+        this._sendLayoutSafeExtendedKey(keysym, targetCode, true);
+        this._sendLayoutSafeExtendedKey(keysym, targetCode, false);
+        if (targetShift) {
+            this._sendLayoutSafeExtendedKey(KeyTable.XK_Shift_L, "ShiftLeft", false);
+        }
+        for (const sourceCode of sourceShifts) {
+            const sourceKeysym = sourceCode === "ShiftRight" ?
+                KeyTable.XK_Shift_R : KeyTable.XK_Shift_L;
+            this._sendLayoutSafeExtendedKey(sourceKeysym, sourceCode, true);
+        }
+    }
